{
  "name": "partyline",
  "version": "0.1.0",
  "private": true,
  "description": "Party games on one laptop, friends join from their phones",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
